rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isStringOrEmpty(v) {
      return v == null || v is string;
    }

    function isTimestampOrNull(v) {
      return v == null || v is timestamp;
    }

    function isBoolOrNull(v) {
      return v == null || v is bool;
    }

    function isMasterPayload() {
      return request.resource.data.keys().hasOnly(['name']) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() > 0 &&
        request.resource.data.name.size() <= 100;
    }

    function isNotificationTokenPayload() {
      return request.resource.data.keys().hasOnly([
        'token',
        'platform',
        'updatedAt',
        'enabled',
        'disabledAt'
      ]) &&
      request.resource.data.token is string &&
      request.resource.data.token.size() > 0 &&
      request.resource.data.token.size() <= 300 &&
      isStringOrEmpty(request.resource.data.platform) &&
      isTimestampOrNull(request.resource.data.updatedAt) &&
      isBoolOrNull(request.resource.data.enabled) &&
      isTimestampOrNull(request.resource.data.disabledAt);
    }

    match /venues/{docId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    match /bookings/{docId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if true;
    }

    match /blocks/{docId} {
      allow read: if true;
      allow create, update: if isMasterPayload();
      allow delete: if true;
    }

    match /categories/{docId} {
      allow read: if true;
      allow create, update: if isMasterPayload();
      allow delete: if true;
    }

    match /powers/{docId} {
      allow read: if true;
      allow create, update: if isMasterPayload();
      allow delete: if true;
    }

    match /attentionItems/{docId} {
      allow read: if true;
      allow create, update: if isMasterPayload();
      allow delete: if true;
    }

    match /notificationTokens/{docId} {
      allow read: if false;
      allow create, update: if isNotificationTokenPayload();
      allow delete: if true;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
